{
  "name": "activist-investing",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "migrate": "pnpm --filter @activist/ingest migrate",
    "pull-edgar": "pnpm --filter @activist/ingest pull-edgar",
    "pull-prices": "pnpm --filter @activist/ingest pull-prices",
    "pull-ecd": "pnpm --filter @activist/ingest pull-ecd",
    "pull-ixbrl": "pnpm --filter @activist/ingest pull-ixbrl",
    "pull-universe": "pnpm --filter @activist/ingest pull-universe",
    "pull-form4": "pnpm --filter @activist/ingest pull-form4",
    "pull-13d": "pnpm --filter @activist/ingest pull-13d",
    "extract-proxy": "pnpm --filter @activist/ingest extract-proxy",
    "screen": "pnpm --filter @activist/ingest screen",
    "render-og": "node scripts/render-og.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=20"
  }
}
