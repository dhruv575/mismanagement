{
  "name": "takeover",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @takeover/site dev",
    "build": "pnpm --filter @takeover/site build",
    "typecheck": "turbo run typecheck",
    "migrate": "pnpm --filter @takeover/ingest migrate",
    "pull-universe": "pnpm --filter @takeover/ingest pull-universe",
    "pull-edgar": "pnpm --filter @takeover/ingest pull-edgar",
    "pull-prices": "pnpm --filter @takeover/ingest pull-prices",
    "pull-ecd": "pnpm --filter @takeover/ingest pull-ecd",
    "pull-ixbrl": "pnpm --filter @takeover/ingest pull-ixbrl",
    "pull-form4": "pnpm --filter @takeover/ingest pull-form4",
    "pull-13d": "pnpm --filter @takeover/ingest pull-13d",
    "pull-votes": "pnpm --filter @takeover/ingest pull-votes",
    "pull-deals": "pnpm --filter @takeover/ingest pull-deals",
    "fill-market-cap": "pnpm --filter @takeover/ingest fill-market-cap",
    "refresh": "pnpm --filter @takeover/ingest refresh-scores",
    "screen": "pnpm --filter @takeover/ingest screen"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=20"
  }
}
