# Neon Postgres -- create a project at https://console.neon.tech, copy the
# connection string here. Used by ingest scripts and the API.
DATABASE_URL=

# Vercel AI Gateway key, used only by the LLM extraction pulls (pull-13d,
# pull-votes). Deterministic pulls run without it.
AI_GATEWAY_API_KEY=
LLM_MODEL=mistral/mistral-nemo

# User-Agent string sent to data.sec.gov. EDGAR rejects requests with no
# UA or with a bare "python-urllib"; include name + email per their policy.
EDGAR_USER_AGENT=Mismanagement yourname@example.com
