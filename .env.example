# Neon Postgres -- create a project at https://console.neon.tech, copy the
# connection string here. Used by ingest scripts and the API.
DATABASE_URL=

# OpenRouter API key. Default text-LLM model is DeepSeek V4 Flash (1M context).
# Vision tasks call sites pin Gemini 3 Flash explicitly via VLM_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VLM_MODEL=google/gemini-3-flash-preview

# User-Agent string sent to data.sec.gov. EDGAR rejects requests with no
# UA or with a bare "python-urllib"; include name + email per their policy.
EDGAR_USER_AGENT=Activist Investing Research yourname@example.com
